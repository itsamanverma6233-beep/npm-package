{
  "name": "ai-stream-typer",
  "version": "1.0.0",
  "description": "Ultra-lightweight, zero-dependency streaming text smoother and typewriter effect for AI (LLM) chat responses.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "ai",
    "streaming",
    "llm",
    "typewriter",
    "typing-effect",
    "openai",
    "gemini",
    "claude",
    "chat",
    "stream-smoother",
    "zero-dependency"
  ],
  "author": "Aman Verma <itsamanverma6233@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsamanverma6233-beep/ai-stream-typer.git"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  }
}
